{
  "name": "devdash",
  "version": "0.1.0",
  "private": true,
  "author": "DevDash",
  "description": "Plugin-based cross-platform developer dashboard (Electron)",
  "main": "out/main/index.js",
  "desktopName": "DevDash.desktop",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:plugins && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:plugins": "node scripts/build-plugins.mjs",
    "stage:plugins": "node scripts/stage-plugins.mjs",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "pack:win": "node scripts/pack.mjs win32 x64",
    "pack:win:dir": "node scripts/pack.mjs win32 x64 --dir",
    "postinstall": "npm run build:plugins && npm run ensure:electron",
    "pack:mac": "node scripts/pack.mjs darwin arm64",
    "pack:mac:dir": "node scripts/pack.mjs darwin arm64 --dir",
    "pack:linux": "node scripts/pack.mjs linux x64",
    "pack:linux:dir": "node scripts/pack.mjs linux x64 --dir"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "esbuild-wasm": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk-linux-x64": "^0.3.308",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "^0.3.308",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  }
}
