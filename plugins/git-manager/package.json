{
  "name": "@devdash/git-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DevDash sample plugin — Git repository manager",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./ui": "./dist/ui.js",
    "./package.json": "./package.json"
  },
  "devdash": {
    "id": "git-manager",
    "title": "Git 管理",
    "icon": "git-branch",
    "ui": "dist/ui.js",
    "main": "dist/main.js",
    "order": 10,
    "ipc": [
      "git:find-repos",
      "git:repo-info",
      "git:status",
      "git:list-files",
      "git:add",
      "git:ignore",
      "git:revert",
      "git:commit",
      "git:push",
      "git:pull",
      "git:unpushed",
      "git:branches",
      "git:checkout",
      "git:log",
      "git:diff-files",
      "git:working-diff-files",
      "git:diff-file-patch",
      "git:commit-files",
      "git:file-at-ref",
      "gitlab:defaults:get",
      "gitlab:defaults:save",
      "gitlab:repo-config:get",
      "gitlab:repo-config:save",
      "gitlab:settings:get",
      "gitlab:settings:save",
      "gitlab:members",
      "gitlab:create-mr",
      "mr-config:get",
      "mr-config:save",
      "settings:get",
      "settings:save",
      "settings:add-whitelist-ext"
    ]
  },
  "scripts": {
    "build": "vite build"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
